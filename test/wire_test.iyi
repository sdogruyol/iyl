module test/wire_test

import std/socket::{IyiSocket}
import std/http::{Server, Response, Request}
import iyl/wire::{Conn, Answer, Fault, Limits, DnsCache, Setup, open, exchange}
import iyl/target::{Target, parse_target}

def handle(req : Request) : Response
  case req.path
  when "/fixed"   then Response.new(200, "x" * 40000)
  when "/chunked" then Response.stream(200) { |w| 5.times { w.write("y" * 1000) } }
  when "/empty"   then Response.new(204, "")
  when "/moved"   then Response.new(302, "", {"Location" => "/fixed"})
  when "/bye"     then Response.new(200, "bye", {"Connection" => "close"})
  else                 Response.new(404, "nope")
  end
end

def get(path : String, port : Int32, method : String = "GET") : String
  "#{method} #{path} HTTP/1.1\r\nHost: 127.0.0.1:#{port}\r\nUser-Agent: test\r\n\r\n"
end

listener = IyiSocket.listen("127.0.0.1", 0)
port = listener.local_port
stop = Channel(Int32).new(1)
target = parse_target("http://127.0.0.1:#{port}/").or_panic
limits = Limits.new(5000, 0_i64)

group do |g|
  g.spawn do
    stop.receive
    listener.close
    0
  end
  g.spawn do
    Server.serve(listener, workers: 1) { |req| handle(req) }
    0
  end
  g.spawn do
    conn = open(target, nil, nil, nil, DnsCache.new, 5000).or_panic
    setup = conn.take_setup
    test "a fresh connection reports its connect time and no lookup" do
      assert setup.is_a?(Setup)
      if setup.is_a?(Setup)
        assert_eq -1_i64, setup.dns_ns
        assert setup.connect_ns >= 0
        assert_eq -1_i64, setup.tls_ns
      end
      assert_nil conn.take_setup
    end

    test "a body framed by its length is counted, not kept" do
      a = exchange(conn, get("/fixed", port), false, false, limits).or_panic
      assert_eq 200, a.status
      assert_eq 40000_i64, a.body_bytes
      assert a.keep_alive
      assert a.first_byte_ns > 0
    end

    test "a chunked body is counted across chunks on the same connection" do
      a = exchange(conn, get("/chunked", port), false, false, limits).or_panic
      assert_eq 200, a.status
      assert_eq 5000_i64, a.body_bytes
      assert_eq 2, conn.served
    end

    test "HEAD and 204 carry no body" do
      a = exchange(conn, get("/fixed", port, "HEAD"), true, false, limits).or_panic
      assert_eq 0_i64, a.body_bytes
      b = exchange(conn, get("/empty", port), false, false, limits).or_panic
      assert_eq 204, b.status
      assert_eq 0_i64, b.body_bytes
    end

    test "a redirect's Location is read when asked for" do
      a = exchange(conn, get("/moved", port), false, true, limits).or_panic
      assert_eq 302, a.status
      assert_eq "/fixed", a.location
    end

    test "Connection: close ends keep-alive" do
      a = exchange(conn, get("/bye", port), false, false, limits).or_panic
      assert_eq 3_i64, a.body_bytes
      assert !a.keep_alive
    end
    conn.close

    test "a refused connection is connect_refused" do
      dead = IyiSocket.listen("127.0.0.1", 0)
      dead_port = dead.local_port
      dead.close
      gone = parse_target("http://127.0.0.1:#{dead_port}/").or_panic
      outcome = open(gone, nil, nil, nil, DnsCache.new, 8000)
      assert outcome.is_a?(Fault)
      assert_eq "connect_refused", outcome.category if outcome.is_a?(Fault)
    end
    stop.send(0)
    0
  end
end
